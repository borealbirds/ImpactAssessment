# papers etc
reading/

# Raster files
*.tif
*.tiff

# RDS files (likely to be big)
*.rds

# History files
.Rhistory
.Rapp.history

# Session Data files
.RData
.RDataTmp

# User-specific files
.Ruserdata

# Output files from R CMD build
/*.tar.gz

# Output files from R CMD check
/*.Rcheck/

# RStudio files
.Rproj.user/

# produced vignettes
vignettes/*.html
vignettes/*.pdf

# OAuth2 token, see https://github.com/hadley/httr/releases/tag/v0.3
.httr-oauth

# knitr and R markdown default cache directories
*_cache/
/cache/

# Temporary files created by R markdown
*.utf8.md
*.knit.md

# R Environment Variables
.Renviron

# pkgdown site
docs/

# shapefiles
*.gpkg
*.shp

# translation temp files
po/*~

# RStudio Connect folder
rsconnect/

# misc media
*.pptx
*.svg
*.png

# Cluster logs and slurm job output
logs/

# Generated output tables (data artifacts, not versioned)
output_tables/

# Generated figures (regenerable outputs, not versioned)
figures/

# Staged raw V5 GIS masking layers (large; staged from G:, not versioned)
data/raw_data/v5_gis/

# Slurm job output pulled to the local tree for inspection
slurm-*.out

# Raster sidecar metadata
*.aux.xml

# Local Claude Code settings (per-machine)
.claude/settings.local.json
